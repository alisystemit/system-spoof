[Unit]
Description=injspoof management panel (Flask + gunicorn)
Documentation=file:@@PREFIX@@/README.md
Documentation=file:@@PREFIX@@/GUIDE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@PREFIX@@
EnvironmentFile=@@ENVFILE@@
# تنها یک worker: نخ نمونه‌بردار (Collector) داخل هر worker یک‌بار اجرا می‌شود؛
# با workerهای بیشتر، هر نمونه‌برداری چند بار روی نودها زده می‌شود.
# کار بار شبکه‌ای است و gthread کشش لازم را می‌دهد.
ExecStart=@@VENV@@/bin/gunicorn \
    --bind @@HOST@@:@@PORT@@ \
    --worker-class gthread --workers 1 --threads 8 \
    --timeout 60 --graceful-timeout 30 --keep-alive 5 \
    --access-logfile - --error-logfile - --capture-output \
    --chdir @@PREFIX@@ app:APP
Restart=on-failure
RestartSec=3

# NoNewPrivileges عمداً false است: صفحه‌ی «هسته» برای کنترل سرویس injspoof
# دستور `sudo -n /usr/local/libexec/injspoof-nodectl …` می‌زند و با NNP=true
# sudo نمی‌تواند مجوز بگیرد (کاربر پنل root نیست و خودِ سرویس هم مستقیم
# چیزی را اجرا نمی‌کند). فایل sudoers فقط همین یک helper را باز می‌کند.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# /etc و /usr برای پنل read-only می‌مانند (ProtectSystem=full)؛ نوشتن فقط در
# state. نوشتن کانفیگ هسته و اعمال فایروال از راه helper ریشه‌پای انجام می‌شود.
ReadWritePaths=@@STATEDIR@@
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
